# Pearl OTC testnet2 + Base Sepolia environment contract.
# No real secret values belong in this file.

NODE_ENV=production
OTC_API_REQUIRE_PRODUCTION_CONFIG=true

PEARL_NETWORK=testnet2
PEARL_ESCROW_ALLOCATOR=p2tr_multisig
PEARL_ESCROW_DERIVATION_PREFIX=0
PEARL_ESCROW_ALLOW_MAINNET=false
PEARL_ESCROW_CONFIRMATIONS=6
PEARL_RELEASE_FEE_GRAINS=0
PEARL_INDEXER_WATCH_URL=http://pearl-indexer-testnet2:8088
PEARL_INDEXER_WATCH_TIMEOUT_MS=5000

BASE_USDC_ESCROW_NETWORK=base_sepolia
BASE_USDC_ESCROW_CONTRACT=0x7edf75ceB2441d80aBC6599CeB4E62Eeb23BB2a9

OTC_QUOTE_TTL_MS=300000
OTC_PEARL_FUNDING_TTL_MS=900000
OTC_USDC_DEPOSIT_TTL_MS=900000
OTC_SETTLEMENT_TTL_MS=1800000
OTC_PRICE_USDC_PER_PRL=0.170000
OTC_FEE_BPS=0

SETTLEMENT_WORKER_ENABLED=false
SETTLEMENT_WORKER_POLL_INTERVAL_MS=10000

PEARL_SIGNER_POLICY_VERSION=pearl-otc-signer-v1
PEARL_SIGNER_RELEASE_FEE_CAP_GRAINS=5000
PEARL_SIGNER_REFUND_FEE_CAP_GRAINS=7000
PEARL_SIGNER_PAUSED=true
PEARL_BROADCAST_ENABLED=false

# External secret mappings:
# OTC_API_DATABASE_URL              <- pearl-otc-api-db
# BASE_RPC_URL                      <- pearl-otc-base-rpc
# PEARL_ESCROW_ARBITER_PUBKEY       <- pearl-otc-multisig-arbiter
# PEARL_ESCROW_XPUB                 <- pearl-otc-p2tr-xpub when PEARL_ESCROW_ALLOCATOR=p2tr_xpub
# PEARLD_RPC_USER                   <- pearl-node-testnet2-rpc
# PEARLD_RPC_PASS                   <- pearl-node-testnet2-rpc
# PEARLD_MINING_ADDRESS             <- pearl-node-testnet2-rpc
# PEARL_INDEXER_DATABASE_URL        <- pearl-indexer-testnet2-db
# PEARL_INDEXER_POSTGRES_PASSWORD   <- pearl-indexer-testnet2-db
# PEARL_SIGNER_KEY_ID               <- pearl-otc-signer-policy
# PEARL_SIGNER_ALLOWED_KEY_IDS      <- pearl-otc-signer-policy
# PEARL_SIGNER_REQUEST_STORE_PATH   <- pearl-otc-signer-store
# PEARL_SIGNER_AUDIT_LOG_PATH       <- pearl-otc-signer-store
# OTC_ALERT_WEBHOOK_URL             <- pearl-otc-operator-alerts
